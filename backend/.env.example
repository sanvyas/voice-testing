# --- LLM providers ---
# You can skip this block and paste your Groq key in the lab under Settings instead.
# Keys saved in Settings override these. Tried in order: Groq, Sarvam, custom.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
# Any OpenAI-compatible endpoint (OpenAI, Together, vLLM, ...). Base URL ends before /chat/completions.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# --- Testing lab ---
# development (default): no auth. production: LAB_API_TOKENS is REQUIRED (the app refuses to start without it).
APP_ENV=development
# Comma-separated secrets (24+ chars in production). Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
LAB_API_TOKENS=
# SQLite by default (backend/data/lab.db). For Postgres: postgresql+psycopg://user:pass@host/db  (pip install "psycopg[binary]")
DATABASE_URL=
# Use a different / stronger model for judging and for the simulated caller than the assistant under test.
JUDGE_PROVIDER=
JUDGE_MODEL=
SIMULATOR_PROVIDER=
SIMULATOR_MODEL=
LAB_MAX_CONCURRENCY=4
LAB_MAX_CONVERSATIONS_PER_RUN=60
LAB_SEED_DEFAULTS=true
LOG_LEVEL=INFO

# --- Client apps (mobile/web) ---
# Encrypts provider keys saved through Settings. 32+ chars. Required on Postgres/containers without a persistent disk;
# with SQLite a key file is created next to the database instead.
LAB_SECRET_KEY=
APP_RATE_LIMIT_PER_MIN=60
# Comma-separated browser origins allowed to call /api/v1 (native mobile apps do not need this).
APP_CORS_ORIGINS=
# Groq gpt-oss models: low | medium | high (low keeps replies fast and inside max_tokens).
GROQ_REASONING_EFFORT=low
